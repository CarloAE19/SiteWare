# ==========================================================
# GB INVENTORY - SERVER SECURITY FIREWALL
# ==========================================================

# 1. DISABLE DIRECTORY BROWSING (Crucial!)
# Prevents hackers from seeing a list of files in folders that don't have an index.php
Options -Indexes

# 2. BLOCK SENSITIVE FILES
# Prevents anyone from downloading your database credentials or server config
<FilesMatch "(^\\.env$|^\\.htaccess$|\\.ini$|\\.log$|\.git)">
    Order allow,deny
    Deny from all
</FilesMatch>

# CUSTOM ERROR PAGES
ErrorDocument 400 /CIMS/error.php?code=400
ErrorDocument 403 /CIMS/error.php?code=403
ErrorDocument 404 /CIMS/error.php?code=404
ErrorDocument 500 /CIMS/error.php?code=500
ErrorDocument 503 /CIMS/error.php?code=503

# 3. CLEAN URLS (Hide .php extensions)
# Allows users to visit /dashboard instead of /dashboard.php and /secure-image or /media/ proof URLs
RewriteEngine On

# Clean Media Proxy Routes (Maps secure-image and /media/ to secure_image.php)
RewriteRule ^secure-image$ secure_image.php [QSA,L]
RewriteRule ^media/([^/]+)/([^/]+)$ secure_image.php?type=$1&file=$2 [QSA,L]

# Redirect direct .php requests to clean URL (e.g. /login.php -> /login)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} \s/+(.+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# 4. INJECT SECURITY HEADERS (Anti-Hacking)
<IfModule mod_headers.c>
    # Prevents "Clickjacking" (Hackers embedding your site in a fake iframe)
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Forces browsers to block Cross-Site Scripting (XSS) attacks
    Header always set X-XSS-Protection "1; mode=block"
    
    # Prevents browsers from "guessing" file types (Stops malicious file uploads from executing)
    Header always set X-Content-Type-Options "nosniff"
    
    # Don't send sensitive referrer data to external websites
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. PREVENT DEFAULT CACHING FOR PHP FILES (Keeps your SPA fresh)
<FilesMatch "\.(php)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
</FilesMatch>

# 6. ENFORCE HTTPS & HSTS SECURITY (Network Protection)
<IfModule mod_rewrite.c>
    # Redirect HTTP to HTTPS (Supports Ngrok & Cloudflare reverse proxies)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
    # Strict-Transport-Security: Forces browsers to use HTTPS for 1 year
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>