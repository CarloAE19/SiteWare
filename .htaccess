# ==========================================================
# GB INVENTORY - SERVER SECURITY FIREWALL
# ==========================================================

# 1. DISABLE DIRECTORY BROWSING (Crucial!)
# Prevents hackers from seeing a list of files in folders that don't have an index.php
Options -Indexes

# 2. BLOCK SENSITIVE FILES
# Prevents anyone from downloading your database credentials or server config
<FilesMatch "(^\\.env$|^\\.htaccess$|\\.ini$|\\.log$|\.git)">
    Order allow,deny
    Deny from all
</FilesMatch>

# CUSTOM ERROR PAGES
ErrorDocument 400 /CIMS/error/400.php
ErrorDocument 403 /CIMS/error/403.php
ErrorDocument 404 /CIMS/error/404.php
ErrorDocument 500 /CIMS/error/500.php
ErrorDocument 503 /CIMS/error/503.php

# 3. CLEAN URLS (Hide .php extensions)
# Allows users to visit /dashboard instead of /dashboard.php and /secure-image or /media/ proof URLs
RewriteEngine On

# Clean Media Proxy Routes (Maps secure-image and /media/ to secure_image.php)
RewriteRule ^secure-image$ secure_image.php [QSA,L]
RewriteRule ^media/([^/]+)/([^/]+)$ secure_image.php?type=$1&file=$2 [QSA,L]

# Redirect direct .php requests to clean URL (e.g. /login.php -> /login)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} \s/+(.+)\.php[\s?] [NC]
RewriteCond %{REQUEST_URI} !secure_image\.php [NC]
RewriteCond %{REQUEST_URI} !process/ [NC]
RewriteRule ^ /%1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# 4. INJECT SECURITY HEADERS (Anti-Hacking)
<IfModule mod_headers.c>
    # Prevents "Clickjacking" (Hackers embedding your site in a fake iframe)
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Forces browsers to block Cross-Site Scripting (XSS) attacks
    Header always set X-XSS-Protection "1; mode=block"
    
    # Prevents browsers from "guessing" file types (Stops malicious file uploads from executing)
    Header always set X-Content-Type-Options "nosniff"
    
    # Don't send sensitive referrer data to external websites
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4.5 GZIP / DEFLATE COMPRESSION (Bandwidth Optimization)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# 5. BROWSER CACHING FOR STATIC ASSETS (0ms Repeat Visit Latency)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType font/woff2 "access plus 1 month"
    ExpiresByType font/woff "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(ico|pdf|jpg|jpeg|png|gif|webp|svg|js|css|woff|woff2|ttf|otf)$">
        Header set Cache-Control "max-age=604800, public"
    </FilesMatch>
</IfModule>

# 5.5 PREVENT DEFAULT CACHING FOR DYNAMIC PHP FILES (Keeps SPA Fresh)
<FilesMatch "\.(php)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
</FilesMatch>

# 6. ENFORCE HTTPS & HSTS SECURITY (Network Protection)
<IfModule mod_rewrite.c>
    # Exclude localhost and 127.0.0.1 so local dev doesn't break Service Workers on self-signed certs
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
    # Strict-Transport-Security: Forces browsers to use HTTPS for 1 year
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>