{
  "version": 2,
  "functions": {
    "api/*.php": { "runtime": "vercel-php@0.7.1" },
    "index.php": { "runtime": "vercel-php@0.7.1" }
  },
  "routes": [
    {
      "src": "/Connection/(.*)",
      "dest": "/Connection/env_loader.php"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}
