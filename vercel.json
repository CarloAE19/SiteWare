{
  "version": 2,
  "functions": {
    "index.php": { "runtime": "vercel-php@0.7.1" },
    "process/process.php": { "runtime": "vercel-php@0.7.1" },
    "*.php": { "runtime": "vercel-php@0.7.1" }
  },
  "routes": [
    {
      "src": "/process/(.*)",
      "dest": "/process/process.php"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}
